{
  "name": "@terra-graph/conventions-core",
  "version": "1.0.0-rc.6",
  "description": "Core convention assets for terra-graph",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/terra-graph/conventions"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "type": "module",
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && tsc -p tsconfig-commonjs.json && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "test": "jest --config jest.config.cjs --coverage",
    "semantic-release": "semantic-release"
  },
  "peerDependencies": {
    "@terra-graph/core": "^1.0.0-rc.4"
  },
  "devDependencies": {
    "@terra-graph/core": "^1.0.0-rc.4"
  },
  "publishConfig": {
    "access": "public"
  }
}

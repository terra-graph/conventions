{
  "name": "@terra-graph-conventions/aws",
  "version": "0.0.0-development",
  "description": "AWS convention assets for terra-graph",
  "license": "MIT",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "type": "module",
  "files": ["dist", "CHANGELOG.md", "README.md"],
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && tsc -p tsconfig-commonjs.json && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "test": "jest --config jest.config.cjs --coverage",
    "semantic-release": "semantic-release"
  },
  "peerDependencies": {
    "terra-graph": "^1.3.3 || ^2.0.0"
  },
  "devDependencies": {
    "terra-graph": "file:../../../terra-graph"
  },
  "publishConfig": {
    "access": "public"
  }
}
